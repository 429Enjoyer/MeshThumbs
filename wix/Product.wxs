          <RegistryValue Type="string" Value="3D Model Thumbnail Provider GLB" />
          <RegistryValue Name="DisableProcessIsolation" Type="integer" Value="1" />
          <RegistryKey Key="InprocServer32"><RegistryValue Type="string" Value="[#ThumbDll]" /><RegistryValue Name="ThreadingModel" Type="string" Value="Both" /></RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00004}">
          <RegistryValue Type="string" Value="3D Model Thumbnail Provider GLTF" />
          <RegistryValue Name="DisableProcessIsolation" Type="integer" Value="1" />
          <RegistryKey Key="InprocServer32"><RegistryValue Type="string" Value="[#ThumbDll]" /><RegistryValue Name="ThreadingModel" Type="string" Value="Both" /></RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".stl\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00005}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.stl\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00005}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00005}">
          <RegistryValue Type="string" Value="3D Model Thumbnail Provider STL" />
          <RegistryValue Name="DisableProcessIsolation" Type="integer" Value="1" />
          <RegistryKey Key="InprocServer32"><RegistryValue Type="string" Value="[#ThumbDll]" /><RegistryValue Name="ThreadingModel" Type="string" Value="Both" /></RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".dae\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00006}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="SystemFileAssociations\.dae\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00006}" />
        </RegistryKey>

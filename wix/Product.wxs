<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="MeshThumbs"
    Language="1033"
    Version="1.1.4"
    Manufacturer="MeshThumbs"
    UpgradeCode="5d411f35-6764-41dd-ae2b-20792d111c23">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="Windows Explorer thumbnails for 3D models" />

    <!-- Install shared components before retiring the old product. Removing the
         old package first exposes a missing/mixed worker while Explorer is live. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute" DowngradeErrorMessage="A newer version of MeshThumbs is already installed." />
    <!-- RM can fail to close/restart the desktop across installer/user contexts.
         Retain file-in-use detection; let MSI request a reboot for locked files
         instead of automatically shutting down Explorer. Do not suppress reboot. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" Secure="yes" />
    <MediaTemplate EmbedCab="yes" />
    <UIRef Id="MeshThumbsUI" />
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)\wix\obj\License.rtf" />
    <!-- Available before InstallFiles: embed the exact script in this MSI,
         never depend on the older copy installed on the user's computer. -->
    <Property Id="MeshThumbsExplorerScript" Value="$(var.RestartExplorerCommand)" Hidden="yes" />
    <CustomAction Id="RestartExplorerFromUI" Directory="TARGETDIR" Execute="immediate" Return="ignore"
      ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -EncodedCommand [MeshThumbsExplorerScript]" />

    <CustomAction
      Id="ClearExplorerCacheOnInstall"
      Directory="TARGETDIR"
      Execute="immediate"
      Return="ignore"
      ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#ClearCacheScript]&quot; -RefreshOnly" />

    <CustomAction
      Id="ClearExplorerCacheOnUninstall"
      Directory="TARGETDIR"
      Execute="immediate"
      Return="ignore"
      ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#ClearCacheScript]&quot; -RefreshOnly" />

    <InstallExecuteSequence>
      <Custom Action="ClearExplorerCacheOnInstall" After="InstallFinalize">NOT REMOVE="ALL"</Custom>
      <!-- Only the new package refreshes after upgrade. Shared components remain
           installed during old-product removal; no custom Explorer restart. -->
      <Custom Action="ClearExplorerCacheOnUninstall" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="MeshThumbs" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="StepRuntimeComponents" />
      <ComponentGroupRef Id="SceneRuntimeComponents" />
      <ComponentGroupRef Id="IfcRuntimeComponents" />
      <ComponentRef Id="ProgramDataLogDir" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="MeshThumbs">
          <Directory Id="STEPFOLDER" Name="step" />
          <Directory Id="SCENEFOLDER" Name="scene" />
          <Directory Id="IFCFOLDER" Name="ifc" />
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="ProgramDataVendor" Name="MeshThumbs" />
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="WixUiSources" Guid="*" Win64="yes">
        <File Id="WixUiSource" Source="$(var.ProjectDir)\docs\third-party\wix-source-3.14.1.zip" KeyPath="yes" />
      </Component>
      <Component Id="InstallerSources" Guid="*" Win64="yes">
        <File Id="InstallerSource" Source="$(var.ProjectDir)\wix\obj\meshthumbs-installer-source.zip" KeyPath="yes" />
      </Component>
      <Component Id="ThumbnailProviderDll" Guid="dedfa04d-b418-4403-b323-bf2e5b23ac3e" Win64="yes">
        <File Id="ThumbDll" Source="$(var.TargetDir)\thumbnail_provider.dll" KeyPath="yes" />
        <File Id="ThumbnailWorker" Source="$(var.TargetDir)\thumbgen.exe" />
        <File Id="ClearCacheScript" Source="$(var.ProjectDir)\scripts\clear-explorer-cache.ps1" />
        <File Id="ThirdPartyNotices" Source="$(var.ProjectDir)\docs\THIRD-PARTY-NOTICES.txt" />
        <File Id="ProjectLicense" Source="$(var.ProjectDir)\LICENSE" />
        <File Id="OptionExtSource" Source="$(var.ProjectDir)\docs\third-party\option-ext-0.2.0.crate" />

        <RegistryKey Root="HKCR" Key=".obj\shellex\{e357fccd-a995-4576-b01f-234630154e96}">

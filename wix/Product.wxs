          <RegistryValue Name="DisableProcessIsolation" Type="integer" Value="1" />
          <RegistryKey Key="InprocServer32"><RegistryValue Type="string" Value="[#ThumbDll]" /><RegistryValue Name="ThreadingModel" Type="string" Value="Both" /></RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="ProgramDataVendor">
      <Component Id="ProgramDataLogDir" Guid="ff1433b1-fdcb-49cb-b43d-40fc8cd52c1b" Win64="yes">
        <CreateFolder />
        <RemoveFile Id="RemoveProgramDataLogs" Name="*" On="uninstall" />
        <RemoveFolder Id="RemoveProgramDataVendor" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\3DThumbnails" Name="LogDir" Type="string" Value="[ProgramDataVendor]" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>


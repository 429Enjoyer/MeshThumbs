<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="3DThumbnails"
    Language="1033"
    Version="1.0.1"
    Manufacturer="3DThumbnails"
    UpgradeCode="1c8b7d42-3648-4d5f-9bb1-bb7644cda908">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="Windows Explorer thumbnail provider for OBJ, FBX, glTF, STL, DAE, PLY and 3DS files" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of 3DThumbnails is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <CustomAction
      Id="ClearExplorerCacheOnInstall"
      Directory="TARGETDIR"
      Execute="immediate"
      Return="ignore"
      ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#ClearCacheScript]&quot;" />

    <CustomAction
      Id="ClearExplorerCacheOnUninstall"
      Directory="TARGETDIR"
      Execute="immediate"
      Return="ignore"
      ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#ClearCacheScript]&quot;" />

    <InstallExecuteSequence>
      <Custom Action="ClearExplorerCacheOnInstall" After="InstallFinalize">NOT REMOVE="ALL"</Custom>
      <Custom Action="ClearExplorerCacheOnUninstall" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="3DThumbnails" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ProgramDataLogDir" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="3DThumbnails" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="ProgramDataVendor" Name="3DThumbnails" />
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ThumbnailProviderDll" Guid="78bd76f2-a4a7-4e8a-93c4-daf56df96a21" Win64="yes">
        <File Id="ThumbDll" Source="$(var.TargetDir)\thumbnail_provider.dll" KeyPath="yes" />
        <File Id="ThumbnailWorker" Source="$(var.TargetDir)\thumbgen.exe" />
        <File Id="ClearCacheScript" Source="$(var.ProjectDir)\scripts\clear-explorer-cache.ps1" />
        <File Id="ThirdPartyNotices" Source="$(var.ProjectDir)\THIRD-PARTY-NOTICES.txt" />
        <RemoveRegistryKey Root="HKCR" Key="VisualStudio.obj.4a87b58f\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\.obj\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\.fbx\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\.glb\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\.gltf\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\SystemFileAssociations\.obj\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\SystemFileAssociations\.fbx\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\SystemFileAssociations\.glb\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\SystemFileAssociations\.gltf\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\CLSID\{4C6F2B8A-5D2E-4C64-9AC7-B6FD046A8241}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00001}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00002}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00003}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00004}" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKCR" Key="AppXmgw6pxxs62rbgfp9petmdyb4fx7rnd4k\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key=".obj\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key=".fbx\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key=".glb\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key=".gltf\shellex\{e357fccd-a995-4576-b01f-234630154e96}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key="CLSID\{4C6F2B8A-5D2E-4C64-9AC7-B6FD046A8241}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00001}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00002}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00003}" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00004}" Action="removeOnUninstall" />
        <RegistryKey Root="HKCR" Key="AppXmgw6pxxs62rbgfp9petmdyb4fx7rnd4k\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{4C6F2B8A-5D2E-4C64-9AC7-B6FD046A8241}" />
        </RegistryKey>

        <RegistryKey Root="HKCR" Key=".obj\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00001}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".fbx\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00002}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".glb\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00003}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key=".gltf\shellex\{e357fccd-a995-4576-b01f-234630154e96}">
          <RegistryValue Type="string" Value="{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00004}" />
        </RegistryKey>

        <RegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00001}">
          <RegistryValue Type="string" Value="3D Model Thumbnail Provider OBJ" />
          <RegistryValue Name="DisableProcessIsolation" Type="integer" Value="1" />
          <RegistryKey Key="InprocServer32"><RegistryValue Type="string" Value="[#ThumbDll]" /><RegistryValue Name="ThreadingModel" Type="string" Value="Both" /></RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="CLSID\{4C6F2B8A-5D2E-4C64-9AC7-B6FD046A8241}">
          <RegistryValue Type="string" Value="3D Model Thumbnail Provider Legacy" />
          <RegistryValue Name="DisableProcessIsolation" Type="integer" Value="1" />
          <RegistryKey Key="InprocServer32"><RegistryValue Type="string" Value="[#ThumbDll]" /><RegistryValue Name="ThreadingModel" Type="string" Value="Both" /></RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="CLSID\{0EF2C8D1-7B70-48C9-B7B8-0F45D3D00002}">
          <RegistryValue Type="string" Value="3D Model Thumbnail Provider FBX" />
          <RegistryValue Name="DisableProcessIsolation" Type="integer" Value="1" />
          <RegistryKey Key="InprocServer32"><RegistryValue Type="string" Value="[#ThumbDll]" /><RegistryValue Name="ThreadingModel" Type="string" Value="Both" /></RegistryKey>
        </RegistryKey>

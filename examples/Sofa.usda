def "_materials"
{
    def Material "GlamVelvetSofa_feet"
    {
        token outputs:surface.connect = </_materials/GlamVelvetSofa_feet/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (1, 0.8, 0.7)
            float inputs:ior = 1.5
            float inputs:metallic = 1
            float inputs:opacity = 1
            float inputs:roughness = 0.4
            float inputs:specular = 0.5
            token outputs:surface
        }
    }

    def Material "GlamVelvetSofa_fabric_navy"
    {
        token outputs:surface.connect = </_materials/GlamVelvetSofa_fabric_navy/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (0.76, 0.53, 0.54)
            float inputs:ior = 1.5
            float inputs:metallic = 0
            float3 inputs:normal.connect = </_materials/GlamVelvetSofa_fabric_navy/Image_Texture.outputs:rgb>
            float inputs:opacity = 1
            float inputs:roughness = 0.7
            float inputs:specular = 0.5
            token outputs:surface
        }

        def Shader "Image_Texture"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, -1)
            asset inputs:file = @./textures/Image_1.png@
            float4 inputs:scale = (2, 2, 2, 2)
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </_materials/GlamVelvetSofa_fabric_navy/UV_Map.outputs:result>
            float3 outputs:rgb
        }

        def Shader "UV_Map"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "UVMap"
            float2 outputs:result
        }
    }

    def Material "GlamVelvetSofa_legs"
    {
        token outputs:surface.connect = </_materials/GlamVelvetSofa_legs/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
            float inputs:ior = 1.5
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.4
            float inputs:specular = 0.5
            token outputs:surface
        }
    }
}

